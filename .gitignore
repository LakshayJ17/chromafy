# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the placeholder-only example env file
!.env.example

# test output
/test-results/
/playwright-report/


# real-provider smoke test output
/smoke-output/

# local assistant and design tooling (kept on this machine only)
/.claude/
/.taste-skill/
/skills-lock.json
/CLAUDE.md
/AGENTS.md

# editors and logs
.vscode/
.idea/
*.log

# Copy to .env.local for development. Never commit real values.
# All variables are read on the server only. None use the NEXT_PUBLIC_ prefix.

# --- Image provider: configure ONE of the two below. ---
# Without any provider the app runs and says "Live transformation isn't set up
# yet"; nothing is faked. If both are configured, IMAGE_PROVIDER must choose.
IMAGE_PROVIDER=

# Option A: Cloudflare Workers AI (free daily allocation, no card needed).
# Account ID: Cloudflare dashboard → Workers AI (32 hex characters).
# API token: My Profile → API Tokens → create a token with "Workers AI: Read" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: @cf/black-forest-labs/flux-2-klein-4b (default, cheapest) or
# @cf/black-forest-labs/flux-2-klein-9b (higher quality, uses far more neurons).
CLOUDFLARE_IMAGE_MODEL=

# Option B: OpenAI Images API (paid).
OPENAI_API_KEY=
# Optional. Allowlisted: gpt-image-2.5-sunburst (default), gpt-image-2.5-flare,
# gpt-image-2, or their dated snapshots. Anything else fails configuration.
OPENAI_IMAGE_MODEL=

# Required in production. Without both, production refuses all transform
# requests (fail closed). Development falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Misuse protection. Each person (network address) gets DAILY_IMAGE_LIMIT
# transformations per UTC day; DAILY_GLOBAL_LIMIT caps everyone together so the
# provider allowance cannot be drained (80 fits Cloudflare's free tier).
DAILY_IMAGE_LIMIT=5
DAILY_GLOBAL_LIMIT=80

# Cloudflare Turnstile bot check (free). Create a widget in the Cloudflare
# dashboard → Turnstile, add your domain (and localhost for testing).
# The site key is public; the secret key is not. Set both or neither.
# For local testing only, Cloudflare's dummy keys are 1x00000000000000000000BB /
# 1x0000000000000000000000000000000AA; production refuses them.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upload limits enforced by the server (1–20 MB; 1M–50M pixels).
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=20000000

# Only for hosts other than Vercel: the header your proxy sets with the real
# client IP and that clients cannot spoof (for example cf-connecting-ip).
# On Vercel, x-vercel-forwarded-for is used automatically. Leave empty otherwise:
# every client then shares one rate-limit bucket, which is strict but safe.
TRUSTED_CLIENT_IP_HEADER=
